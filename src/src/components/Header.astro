---
import { locales, type Locale } from '../lib/i18n';

interface Props {
  alternatePath?: string;
  locale: Locale;
}

const { alternatePath, locale } = Astro.props;
const config = locales[locale];
const mainSiteUrl = import.meta.env.PUBLIC_MAIN_SITE_URL ?? 'https://bigmelo.com';
const adminUrl = import.meta.env.PUBLIC_ADMIN_URL ?? 'https://admin.bigmelo.com';
const currentPath = Astro.url.pathname;
const esPath = locale === 'es' ? currentPath : (alternatePath ?? locales.es.homePath);
const enPath = locale === 'en' ? currentPath : (alternatePath ?? locales.en.homePath);
const signInUrl = new URL('/auth/custom/sign-in', adminUrl);
signInUrl.searchParams.set('locale', locale);

const copy = locale === 'es'
  ? { blog: 'Blog', contact: 'Contacto', plans: 'Planes', product: 'Producto', signIn: 'Ingresar' }
  : { blog: 'Blog', contact: 'Contact', plans: 'Plans', product: 'Product', signIn: 'Sign in' };
---

<header class="site-header" data-site-header>
  <div class="header-shell">
    <a class="brand" href={config.homePath} aria-label="Bigmelo Blog">
      <img src="/bigmelo-logo.png" alt="Bigmelo" width="159" height="32" />
      <span>Blog</span>
    </a>

    <nav class="site-navigation" id="site-navigation" aria-label="Main navigation" data-navigation>
      <a href={`${mainSiteUrl}/#product`}>{copy.product}</a>
      <a href={`${mainSiteUrl}/#plans`}>{copy.plans}</a>
      <a class="is-current" href={config.homePath}>{copy.blog}</a>
      <a href={`${mainSiteUrl}/#contact`}>{copy.contact}</a>
    </nav>

    <div class="header-actions">
      <a class="admin-link" href={signInUrl}>
        {copy.signIn}
      </a>
      <div class="language-switch" aria-label={locale === 'es' ? 'Idioma' : 'Language'}>
        <a class:list={[locale === 'es' && 'is-active']} href={esPath} hreflang="es">ES</a>
        <a class:list={[locale === 'en' && 'is-active']} href={enPath} hreflang="en">EN</a>
      </div>
    </div>
  </div>
</header>
