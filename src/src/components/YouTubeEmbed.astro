---
interface Props {
  linkLabel: string;
  title: string;
  videoId: string;
  watchUrl: string;
}

const { linkLabel, title, videoId, watchUrl } = Astro.props;
const embedUrl = new URL(`https://www.youtube-nocookie.com/embed/${videoId}`);
embedUrl.searchParams.set('rel', '0');
---

<div class="video-embed">
  <iframe
    src={embedUrl.toString()}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>
<p class="video-fallback">
  <a href={watchUrl} target="_blank" rel="noopener noreferrer">{linkLabel}<span aria-hidden="true"> ↗</span></a>
</p>

<style>
  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 2.4rem 0 0.8rem;
    overflow: hidden;
    background: #101624;
    border: 1px solid rgba(16, 22, 36, 0.1);
    border-radius: 16px;
    box-shadow: 0 28px 70px rgba(16, 22, 36, 0.15);
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-fallback {
    margin: 0 0 2.6rem;
    color: #667085;
    font-size: 0.88rem;
    text-align: right;
  }

  .video-fallback a {
    font-weight: 750;
    text-decoration: underline;
    text-decoration-color: rgba(16, 22, 36, 0.28);
    text-underline-offset: 4px;
  }
</style>
