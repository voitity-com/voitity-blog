---
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const configuredMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim();
const measurementId = configuredMeasurementId && /^G-[A-Z0-9]+$/.test(configuredMeasurementId)
  ? configuredMeasurementId
  : undefined;
const mainSiteUrl = import.meta.env.PUBLIC_MAIN_SITE_URL ?? 'https://bigmelo.com';
const copy = locale === 'es'
  ? {
      accept: 'Aceptar',
      body: 'Usamos analítica opcional para entender qué contenidos resultan útiles. No enviamos información privada ni contenido de conversaciones.',
      privacy: 'Ver privacidad',
      reject: 'Rechazar',
      title: 'Tu privacidad importa',
    }
  : {
      accept: 'Accept',
      body: 'We use optional analytics to understand which content is useful. We do not send private information or conversation content.',
      privacy: 'View privacy policy',
      reject: 'Reject',
      title: 'Your privacy matters',
    };
---

{measurementId && (
  <aside id="analytics-consent" class="analytics-consent" role="dialog" aria-label={copy.title} hidden data-consent-banner data-measurement-id={measurementId}>
    <div>
      <strong>{copy.title}</strong>
      <p>{copy.body}</p>
      <a href={locale === 'es' ? `${mainSiteUrl}/privacidad` : `${mainSiteUrl}/privacy`}>{copy.privacy}</a>
    </div>
    <div class="consent-actions">
      <button class="button button-secondary" type="button" data-consent="denied">{copy.reject}</button>
      <button class="button button-primary" type="button" data-consent="granted">{copy.accept}</button>
    </div>
  </aside>
)}

<script>
  const COOKIE_NAME = 'bigmelo_analytics_consent';
  const COOKIE_MAX_AGE_SECONDS = 60 * 60 * 24 * 365;
  const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
  const measurementId = banner?.dataset.measurementId;
  const isBigmeloHost = location.hostname === 'bigmelo.com' || location.hostname.endsWith('.bigmelo.com');
  let analyticsConfigured = false;
  let consentDefaultsConfigured = false;
  let pageViewSent = false;

  function readConsent() {
    const part = document.cookie.split(';').map((value) => value.trim()).find((value) => value.startsWith(`${COOKIE_NAME}=`));
    return part?.split('=')[1];
  }

  function cookieAttributes(maxAge: number) {
    const domain = isBigmeloHost ? '; Domain=.bigmelo.com; Secure' : '';
    return `Path=/; Max-Age=${maxAge}; SameSite=Lax${domain}`;
  }

  function ensureGtag() {
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag() {
      window.dataLayer.push(arguments);
    };
  }

  function configureConsentDefaults() {
    if (consentDefaultsConfigured) return;
    ensureGtag();
    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
    });
    window.gtag('set', 'ads_data_redaction', true);
    consentDefaultsConfigured = true;
  }

  function updateConsent(value: 'granted' | 'denied') {
    configureConsentDefaults();
    window.gtag('consent', 'update', {
      analytics_storage: value,
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
  }

  function removeAnalyticsCookies() {
    const names = document.cookie
      .split(';')
      .map((part) => part.trim().split('=')[0])
      .filter((name) => name === '_ga' || name.startsWith('_ga_'));
    const secure = location.protocol === 'https:' ? '; Secure' : '';

    names.forEach((name) => {
      document.cookie = `${name}=; ${cookieAttributes(0)}`;
      document.cookie = `${name}=; Path=/; Max-Age=0; SameSite=Lax${secure}`;
    });
  }

  function getPublicReferrer() {
    if (!document.referrer) return '';
    try {
      const referrer = new URL(document.referrer);
      return `${referrer.origin}${referrer.pathname}`;
    } catch {
      return '';
    }
  }

  function loadAnalytics() {
    if (!measurementId || !isBigmeloHost) return;
    updateConsent('granted');

    const pageLocation = `${location.origin}${location.pathname}`;
    const pageReferrer = getPublicReferrer();
    if (!analyticsConfigured) {
      window.gtag('js', new Date());
      window.gtag('config', measurementId, {
        allow_ad_personalization_signals: false,
        allow_google_signals: false,
        page_location: pageLocation,
        page_path: location.pathname,
        page_referrer: pageReferrer,
        page_title: document.title,
        send_page_view: false,
      });
      analyticsConfigured = true;
    }

    if (!document.getElementById('bigmelo-blog-ga')) {
      const script = document.createElement('script');
      script.async = true;
      script.id = 'bigmelo-blog-ga';
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      document.head.appendChild(script);
    }

    if (!pageViewSent) {
      window.gtag('event', 'page_view', {
        app_surface: 'blog',
        page_location: pageLocation,
        page_path: location.pathname,
        page_referrer: pageReferrer,
        page_title: document.title,
      });
      pageViewSent = true;
    }
  }

  function setConsent(value: 'granted' | 'denied') {
    document.cookie = `${COOKIE_NAME}=${value}; ${cookieAttributes(COOKIE_MAX_AGE_SECONDS)}`;
    if (value === 'granted') {
      loadAnalytics();
    } else {
      updateConsent('denied');
      pageViewSent = false;
      removeAnalyticsCookies();
    }
    banner?.setAttribute('hidden', '');
  }

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
    button.addEventListener('click', () => setConsent(button.dataset.consent as 'granted' | 'denied'));
  });

  document.querySelectorAll<HTMLButtonElement>('[data-cookie-settings]').forEach((button) => {
    button.addEventListener('click', () => banner?.removeAttribute('hidden'));
  });

  configureConsentDefaults();
  const consent = readConsent();
  if (consent === 'granted') {
    loadAnalytics();
  } else if (consent === 'denied') {
    updateConsent('denied');
  } else {
    banner?.removeAttribute('hidden');
  }
</script>
