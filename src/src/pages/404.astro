---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="es" title="Página no encontrada | Bigmelo Blog" description="La página solicitada no existe en el blog de Bigmelo." canonicalPath="/404" robots="noindex,follow">
  <section class="not-found-page page-shell">
    <span>404</span>
    <h1>Esta historia aún no existe.</h1>
    <p>La página que buscas cambió de lugar o todavía no ha sido publicada.</p>
    <a class="button button-primary" href="/es">Volver al blog <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
